---
// Barre de confiance : avis Google (logo + étoiles + moyenne) + logo RGE Qualibat.
// Utilisée sous le hero de l'accueil, des pages villes et des pages services.
import { company } from '../data/site';

interface Props {
  /** true = affiche aussi le logo Éric Couvreur au-dessus (accueil) */
  showLogo?: boolean;
}
const { showLogo = false } = Astro.props;
---
<div class="container">
  {showLogo && (
    <img class="trust-logo" src="/eric-couvreur-logo.png" width="512" height="512" alt="Éric Couvreur, artisan couvreur RGE Qualibat dans l'Essonne" />
  )}
  <div class="trust-band">
    <a class="trust-reviews" href={company.googleUrl} target="_blank" rel="noopener" aria-label={`Avis Google : ${company.reviews.rating} sur 5`}>
      <svg class="g-logo" viewBox="0 0 48 48" width="26" height="26" aria-hidden="true">
        <path fill="#FFC107" d="M43.611 20.083H42V20H24v8h11.303c-1.649 4.657-6.08 8-11.303 8-6.627 0-12-5.373-12-12s5.373-12 12-12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 12.955 4 4 12.955 4 24s8.955 20 20 20 20-8.955 20-20c0-1.341-.138-2.65-.389-3.917z"/>
        <path fill="#FF3D00" d="M6.306 14.691l6.571 4.819C14.655 15.108 18.961 12 24 12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 16.318 4 9.656 8.337 6.306 14.691z"/>
        <path fill="#4CAF50" d="M24 44c5.166 0 9.86-1.977 13.409-5.192l-6.19-5.238C29.211 35.091 26.715 36 24 36c-5.202 0-9.619-3.317-11.283-7.946l-6.522 5.025C9.505 39.556 16.227 44 24 44z"/>
        <path fill="#1976D2" d="M43.611 20.083H42V20H24v8h11.303c-.792 2.237-2.231 4.166-4.087 5.571l6.19 5.238C36.971 39.205 44 34 44 24c0-1.341-.138-2.65-.389-3.917z"/>
      </svg>
      <span class="trust-reviews__text">
        <span class="stars" aria-hidden="true">★★★★☆</span>
        <span class="trust-reviews__meta"><strong>{company.reviews.rating}/5</strong> · {company.reviews.count} avis clients</span>
      </span>
    </a>
    <span class="trust-sep" aria-hidden="true"></span>
    <img class="trust-qualibat" src="/logo-qualibat.png" width="1772" height="1161" alt="Certifié RGE Qualibat — efficacité énergétique" />
  </div>
</div>
