---
// Layout de base eric-couvreur.fr
// <head> + données structurées (SEO local + logo de marque en SERP).
// Déposer le logo carré dans public/eric-couvreur-logo.png (≥ 512×512, fond clair).
import '@fontsource/roboto/latin-300.css';
import '@fontsource/roboto/latin-400.css';
import '@fontsource/roboto/latin-500.css';
import '@fontsource/roboto/latin-700.css';
import '@fontsource/roboto/latin-900.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { company } from '../data/site';
import { communes } from '../data/communes';

// Prestations (catalogue de services, avec l'URL de chaque page)
const SITE_URL = 'https://eric-couvreur.fr';
const servicesLd = [
  ['Travaux de couverture', '/travaux-de-couverture/'],
  ['Rénovation de toiture', '/prestations/renovation-detoiture/'],
  ['Réparation de toiture et recherche de fuite', '/reparation-toiture-fuite-91/'],
  ['Nettoyage et démoussage de toiture', '/nettoyage-demoussage-toiture-91/'],
  ['Traitement anti-mousse de toiture', '/traitement-anti-mousse-toiture-91/'],
  ['Traitement hydrofuge de toiture', '/traitement-hydrofuge-toiture-91/'],
  ['Pose et remplacement de fenêtres de toit Velux (RGE)', '/installateur-de-velux-91/'],
  ['Isolation des combles perdus (RGE)', '/isolation-des-combles/'],
  ['Isolation des rampants (RGE)', '/isolation-des-rampants/'],
  ['Isolation de toiture par l’extérieur — sarking (RGE)', '/prestations/isolation-de-toiture-91/'],
  ['Traitement de charpente', '/traitement-de-charpente/'],
  ['Ramonage', '/prestations/ramonage-91/'],
  ['Ravalement de façade', '/prestations/ravalement-de-facade-91/'],
].map(([name, path]) => ({
  '@type': 'Offer',
  itemOffered: { '@type': 'Service', name, url: `${SITE_URL}${path}` },
}));

export interface Props {
  title: string;
  description: string;
  /** Chemin canonique, ex : "/travaux-de-couverture/" */
  path?: string;
  /** true = page en noindex */
  noindex?: boolean;
  /** true = masque le CTA « Devis gratuit » du header/footer (page devis elle-même) */
  hideQuoteCta?: boolean;
  /** Pages villes : nom de la commune — areaServed du schema ne contient alors QUE cette ville */
  areaServedVille?: string;
  /** Libellé de la page dans le fil d'Ariane — ajoute un BreadcrumbList (Accueil → page) au schema */
  breadcrumbName?: string;
  /** Pages services : nom de la prestation — ajoute un nœud Service au schema */
  serviceName?: string;
}

const { title, description, path = '/', noindex = false, hideQuoteCta = false, areaServedVille, breadcrumbName, serviceName } = Astro.props;

// areaServed : la ville seule (pages villes), sinon le département (91) + toutes les communes desservies
const areaServedLd = areaServedVille
  ? [{ '@type': 'City', name: areaServedVille }]
  : [
      { '@type': 'AdministrativeArea', name: 'Essonne (91)' },
      ...communes.map((c) => ({ '@type': 'City', name: c.nom })),
    ];

const SITE = 'https://eric-couvreur.fr';
const canonical = new URL(path, Astro.site ?? SITE).href;
const logoUrl = `${SITE}/eric-couvreur-logo.png`;
// Variante aplatie sur blanc : un PNG à fond transparent s'affiche sur fond noir
// dans une partie des aperçus sociaux (WhatsApp, Slack, X).
const ogImageUrl = `${SITE}/eric-couvreur-logo-og.png`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE}/#website`,
      url: `${SITE}/`,
      name: 'Éric Couvreur',
      alternateName: 'Couvreur 91 RGE Qualibat — Éric Couvreur',
      inLanguage: 'fr-FR',
      publisher: { '@id': `${SITE}/#localbusiness` },
    },
    {
      '@type': 'RoofingContractor',
      '@id': `${SITE}/#localbusiness`,
      name: company.name,
      alternateName: 'Couvreur 91 RGE Qualibat — Éric Couvreur',
      description:
        'Artisan couvreur RGE Qualibat dans l’Essonne (91). Travaux de couverture, rénovation et réparation de toiture, isolation, ravalement de façade, ramonage et pose de Velux.',
      url: `${SITE}/`,
      image: logoUrl,
      logo: logoUrl,
      telephone: company.phoneE164,
      email: company.email,
      priceRange: company.priceRange,
      founder: { '@type': 'Person', name: company.founder },
      foundingDate: company.foundingDate,
      address: {
        '@type': 'PostalAddress',
        streetAddress: company.street,
        postalCode: company.postalCode,
        addressLocality: company.city,
        addressRegion: company.region_admin,
        addressCountry: 'FR',
      },
      geo: { '@type': 'GeoCoordinates', latitude: company.geo.lat, longitude: company.geo.lng },
      openingHoursSpecification: {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: company.hours.days,
        opens: company.hours.opens,
        closes: company.hours.closes,
      },
      areaServed: areaServedLd,
      knowsAbout: [
        'Couverture', 'Zinguerie', 'Gouttières, noues et chéneaux', 'Rénovation de toiture',
        'Réparation de fuite de toiture', 'Démoussage de toiture', 'Traitement hydrofuge',
        'Fenêtres de toit Velux', 'Isolation de toiture', 'Isolation des combles', 'Sarking',
        'Traitement de charpente', 'Ramonage', 'Ravalement de façade',
        'Tuiles mécaniques', 'Tuiles plates', 'Ardoises', 'Zinc', 'Bac acier', 'Shingle',
      ],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Prestations de couverture dans l’Essonne',
        itemListElement: servicesLd,
      },
      hasCredential: {
        '@type': 'EducationalOccupationalCredential',
        credentialCategory: 'certification',
        name: 'RGE Qualibat',
        description:
          'Certification RGE (Reconnu Garant de l’Environnement) Qualibat — fenêtres de toit et isolation. SIREN 821 136 488.',
        url: 'https://annuaire-entreprises.data.gouv.fr/labels-certificats/821136488#rge',
        recognizedBy: { '@type': 'Organization', name: 'Qualibat', url: 'https://www.qualibat.com/' },
      },
      sameAs: [company.googleUrl, 'https://annuaire-entreprises.data.gouv.fr/entreprise/couverture-robert-eric-couvreur-821136488'],
    },
    // Fil d'Ariane (pages internes uniquement)
    ...(breadcrumbName
      ? [{
          '@type': 'BreadcrumbList',
          '@id': `${canonical}#breadcrumb`,
          itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE}/` },
            { '@type': 'ListItem', position: 2, name: breadcrumbName, item: canonical },
          ],
        }]
      : []),
    // Prestation de la page (pages services uniquement)
    ...(serviceName
      ? [{
          '@type': 'Service',
          '@id': `${canonical}#service`,
          name: serviceName,
          url: canonical,
          description,
          provider: { '@id': `${SITE}/#localbusiness` },
          areaServed: areaServedLd,
        }]
      : []),
  ],
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />

    <!-- Google n'affiche en SERP qu'un favicon carré de 48 px ou d'un multiple de 48 :
         le .ico embarque 16/32/48, on déclare donc 48x48 (et pas 32x32). -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="google-site-verification" content="YkbEXhKmWFoJgum0U-9IuBcHgakFaIWk2wZNp1REIS8" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Éric Couvreur — Couvreur 91 RGE Qualibat" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:image:alt" content="Logo Éric Couvreur, artisan couvreur RGE dans l’Essonne" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <Header hideQuoteCta={hideQuoteCta} />
    <main id="contenu">
      <slot />
    </main>
    <Footer hideQuoteCta={hideQuoteCta} />
    <CookieBanner />
  </body>
</html>
