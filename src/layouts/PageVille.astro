---
// Gabarit des pages villes : /couvreur-{slug}/
// La page ville LOCALISE (preuves locales, silo vers les piliers) — elle ne
// re-décrit pas les services. Contenu unique par commune : src/data/villes-contenu.ts
import Layout from './Layout.astro';
import { company } from '../data/site';
import { communes, libelleVille, urlVille, type Commune } from '../data/communes';
import { villesContenu } from '../data/villes-contenu';
import { svg } from '../data/prestations';
import TrustBand from '../components/TrustBand.astro';

interface Props { commune: Commune }
const { commune } = Astro.props;

const titre = libelleVille(commune); // ex. « Couvreur à Arpajon »
const contenu = villesContenu[commune.slug];

// Communes voisines réelles si définies, sinon les 8 premières autres communes.
const voisines = contenu
  ? contenu.voisines
      .map((slug) => communes.find((c) => c.slug === slug))
      .filter((c): c is Commune => Boolean(c))
  : communes.filter((c) => c.slug !== commune.slug).slice(0, 8);

// Anti-triplette : title = « Couvreur à X », H1 = « Entreprise de couverture à X », meta = « Couvreur-zingueur à X »
const h1 = contenu
  ? `Entreprise de couverture ${commune.prep} ${commune.nom} : ${contenu.h1tag}`
  : `Entreprise de couverture ${commune.prep} ${commune.nom} : devis gratuit`;

const description = contenu
  ? contenu.meta
  : `Couvreur ${commune.prep} ${commune.nom} (${commune.cp}) : Éric Couvreur, artisan RGE Qualibat. Devis gratuit et déplacement offert.`;

// Cartes prestations localisées (titres avec le nom de la commune)
const ville = `${commune.prep} ${commune.nom}`;
const promosVille = [
  { titre: `Pose et remplacement de Velux ${ville}`, desc: 'Pose et remplacement de fenêtres de toit par un installateur certifié RGE : plus de lumière et une meilleure isolation.', url: '/installateur-de-velux-91/', brand: 'velux', accent: true, feature: true, photo: '/photo-velux.webp' },
  { titre: `Isolation des combles perdus ${ville}`, desc: 'Isolant posé dans les combles non aménagés : le geste le plus rentable pour réduire vos factures.', url: '/isolation-des-combles/', brand: 'icon', icon: 'layers', photo: '/isolation-combles-perdus.webp' },
  { titre: `Isolation des rampants ${ville}`, desc: 'Isolation thermique par l’intérieur, idéale pour les combles aménagés et les rampants de toiture.', url: '/isolation-des-rampants/', brand: 'icon', icon: 'shield', photo: '/photo-isolation-interieur.webp' },
  { titre: `Isolation de toiture par l’extérieur (sarking) ${ville}`, desc: 'Isolation par l’extérieur, sarking et toiture-terrasse : performance maximale sans perdre de volume habitable.', url: '/prestations/isolation-de-toiture-91/', brand: 'icon', icon: 'roof', photo: '/photo-sarking.webp' },
];
---
<Layout
  title={`${titre} (${commune.cp}) — Éric Couvreur RGE Qualibat`}
  description={description}
  path={urlVille(commune)}
  areaServedVille={commune.nom}
  breadcrumbName={titre}
>
  <nav class="breadcrumb" aria-label="Fil d'Ariane">
    <div class="container">
      <ol>
        <li><a href="/">Accueil</a></li>
        <li aria-current="page">{titre}</li>
      </ol>
    </div>
  </nav>

  <section class="page-hero">
    <div class="container">
      <h1>{h1}</h1>
      <p class="page-hero__artisan">{company.name}</p>
      <div class="page-hero__grid">
        <div class="page-hero__text">
          {contenu ? (
            <>
              <p>{contenu.hero[0]}</p>
              <p>{contenu.hero[1]}</p>
            </>
          ) : (
            <>
              <p>Éric Robert, artisan couvreur basé à Linas, intervient {commune.prep} {commune.nom} ({commune.cp}) pour tous vos travaux de toiture : couverture, entretien, réparations, isolation.</p>
              <p>Devis et déplacement gratuits dans toute l’Essonne.</p>
            </>
          )}

          <div class="actions">
            <a class="btn btn--rouge btn--tel" href={company.mobileHref} aria-label={`Appeler le ${company.mobile}`} title={`Appeler le ${company.mobile}`}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="2" width="12" height="20" rx="2.5"/><path d="M12 18h.01"/></svg>{company.mobile}</a>
            <a class="btn btn--ghost" href="/devis-gratuit/" style="color:#fff;border-color:#fff">Demander un devis<span class="btn-menu__arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h11.5M12 6.5l5.5 5.5-5.5 5.5"/></svg></span></a>
          </div>
        </div>
        <div class="page-hero__media">
          <img src="/hero-eric-couvreur.webp" width="891" height="706" alt={`Chantier de couverture ${commune.prep} ${commune.nom} par Éric Couvreur`} />
        </div>
      </div>
    </div>
  </section>

  <TrustBand showLogo />

  <!-- 1. Comme sur l'accueil : les 4 prestations RGE d'abord, mises en avant -->
  <section class="section promo-section">
    <div class="section-head section-head--txt-left">
      <h2>Un artisan certifié RGE {commune.prep} {commune.nom}</h2>
      <p><strong>Nos prestations éligibles aux aides (RGE Qualibat)</strong> : sur ces quatre travaux, MaPrimeRénov’, les primes CEE et la TVA à 5,5 % peuvent s’appliquer. Le devis, gratuit, chiffre les aides mobilisables pour votre projet.</p>
      <p><a href="https://annuaire-entreprises.data.gouv.fr/labels-certificats/821136488#rge" target="_blank" rel="noopener">Vérifier notre certification RGE sur l’annuaire officiel des entreprises</a></p>
    </div>
    <div class="promo-grid">
      {promosVille.map((p) => (
        <a class:list={['promo-card', p.accent && 'promo-card--accent', p.feature && 'promo-card--feature']} href={p.url}>
          <h3>{p.titre}</h3>
          <p>{p.desc}</p>
          {p.photo && <img class="promo-card__photo" src={p.photo} width="1063" height="709" alt={p.titre} />}
          <span class="promo-card__brand">
            {p.brand === 'velux' && <img class="promo-velux" src="/logo-velux.webp" width="106" height="40" alt="Installateur Velux" />}
            {p.brand === 'icon' && !p.photo && <span class="promo-icon" set:html={svg(p.icon ?? '')} />}
            <span class="promo-card__more" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h11.5M12 6.5l5.5 5.5-5.5 5.5"/></svg></span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- 2. Comme sur l'accueil : le spécialiste de la rénovation de toiture -->
  <section class="split-feature">
    <div class="split-feature__inner">
      <div class="split-feature__left">
        <h2>Le spécialiste de la rénovation de toiture {commune.prep} {commune.nom}</h2>
        <p>Tuiles poreuses, faîtage descellé, couverture en bout de course : passé un certain âge, réparer une toiture coûte plus cher que la refaire. Éric Robert remplace les toitures anciennes de A à Z — découvrez notre page <a href="/prestations/renovation-detoiture/">rénovation de toiture</a>.</p>
        <ul class="split-feature__list">
          <li class="is-active">Devis gratuit</li>
          <li>Intervention en moins de 48 heures</li>
          <li>Garantie décennale</li>
        </ul>
      </div>
      <div class="split-feature__right">
        <img class="split-feature__photo" src="/photo-renovation-hero.webp" width="900" height="675" alt={`Rénovation de toiture ${commune.prep} ${commune.nom} par Éric Couvreur`} />
        <div class="split-feature__card">
          <span class="split-feature__badge">Tous matériaux</span>
          <p><strong>Tuiles mécaniques, tuiles plates, ardoises, zinc, bac acier ou shingle</strong> : tous les matériaux de couverture sont travaillés, dans le respect du style de votre maison.</p>
          <p>Devis et déplacement gratuits {commune.prep} {commune.nom} comme dans tout le département.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Comme sur l'accueil : bandeau devis sous la rénovation -->
  <section class="cta-banner-section">
    <div class="cta-banner">
      <div class="cta-banner__media">
        <img src="/eric-robert-portrait.webp" width="450" height="337" alt="Éric Robert, artisan couvreur dans l'Essonne" />
      </div>
      <div class="cta-banner__panel">
        <h2>Besoin d’un couvreur {commune.prep} {commune.nom} ?</h2>
        <p>Éric Robert se déplace gratuitement, examine votre couverture et vous remet un devis clair — réparation, entretien ou rénovation, selon ce que votre toit demande vraiment.</p>
        <a class="btn cta-banner__btn" href="/devis-gratuit/">Demander une intervention<span class="btn-menu__arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h11.5M12 6.5l5.5 5.5-5.5 5.5"/></svg></span></a>
      </div>
    </div>
  </section>

  <!-- 4. Comme sur l'accueil : nettoyage & démoussage -->
  <section class="section">
    <div class="container media-split">
      <div class="media-split__text">
        <h2>Nettoyage et démoussage de toiture {commune.prep} {commune.nom}</h2>
        <p>La mousse retient l’humidité, ronge les tuiles et finit par ouvrir la porte aux infiltrations. Un <a href="/nettoyage-demoussage-toiture-91/">nettoyage et démoussage de toiture</a> régulier prolonge la vie de votre couverture.</p>
        <p>Après le nettoyage, traitement anti-mousse pour empêcher la végétation de revenir et traitement hydrofuge pour ré-imperméabiliser les tuiles poreuses — avec des produits professionnels Dalep.</p>
      </div>
      <div class="media-split__media">
        <img src="/photo-nettoyage-resultat.webp" width="900" height="675" alt={`Toiture nettoyée et démoussée ${commune.prep} ${commune.nom}`} />
      </div>
    </div>
  </section>

  <!-- 5. Comme sur l'accueil : gouttières (fond sombre) -->
  <section class="section media-section--dark">
    <div class="container media-split media-split--reverse">
      <div class="media-split__text">
        <h2>Gouttières, noues et chéneaux {commune.prep} {commune.nom}</h2>
        <p>Une gouttière qui déborde ou qui fuit, et c’est l’eau de pluie qui ruisselle sur la façade et s’infiltre dans les murs. La zinguerie n’est pas un détail : c’est elle qui évacue l’eau loin de votre maison.</p>
        <p>Pose et remplacement de gouttières en zinc ou en aluminium, façonnage des noues, chéneaux et abergements : ces ouvrages font partie de nos <a href="/travaux-de-couverture/">travaux de couverture</a>.</p>
      </div>
      <div class="media-split__media">
        <img src="/photo-gouttieres-1.webp" width="400" height="400" alt={`Pose de gouttières, noues et chéneaux ${commune.prep} ${commune.nom}`} />
      </div>
    </div>
  </section>

  <!-- 6. Comme sur l'accueil : traitement de charpente -->
  <section class="section">
    <div class="container media-split media-split--plain">
      <div class="media-split__text">
        <h2>Traitement de charpente {commune.prep} {commune.nom}</h2>
        <p>Sciure au pied des poutres, petits trous dans le bois : capricornes et vrillettes creusent les charpentes en silence, des années avant que les dégâts ne se voient.</p>
        <p>Après un diagnostic gratuit, le <a href="/traitement-de-charpente/">traitement de charpente</a> par injection ou pulvérisation stoppe les insectes et protège les bois pour des années.</p>
        <a class="btn btn--rouge media-split__cta" href="/devis-gratuit/">Demander un diagnostic gratuit<span class="btn-menu__arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h11.5M12 6.5l5.5 5.5-5.5 5.5"/></svg></span></a>
      </div>
      <div class="media-split__media">
        <img src="/photo-charpente.webp" width="1045" height="870" alt={`Traitement de charpente ${commune.prep} ${commune.nom} par Éric Couvreur`} />
      </div>
    </div>
  </section>

  <section class="section section--gris">
    <div class="container">
      <div class="section-head section-head--left">
        <h2>Éric Couvreur intervient aussi autour de {commune.nom}</h2>
        <p>Le déplacement reste gratuit dans les communes voisines — et dans tout le département.</p>
      </div>
      <div class="liens-proches">
        {voisines.map((c) => (<a href={urlVille(c)}>{libelleVille(c)}</a>))}
      </div>
    </div>
  </section>
</Layout>
