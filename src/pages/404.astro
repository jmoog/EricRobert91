---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page introuvable — Éric Couvreur" description="La page demandée n'existe pas." noindex={true} path="/404">
  <section class="section">
    <div class="container" style="text-align:center">
      <h1>Page introuvable</h1>
      <p>Désolé, cette page n'existe pas ou a été déplacée.</p>
      <p><a class="btn btn--bleu" href="/">Retour à l'accueil</a></p>
    </div>
  </section>
</Layout>
