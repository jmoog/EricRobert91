---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import { company } from '../data/site';
import { prestationsRge as promos, svg } from '../data/prestations';
import TrustBand from '../components/TrustBand.astro';

// Vrais avis Google de la fiche Éric Couvreur.
const reviews = [
  { note: 5, date: 'Août 2025', nom: 'Aurélia Tonnellier', texte: 'Monsieur Robert est un couvreur très disponible et au service de ses clients. Il a refait notre toiture avec son équipe. Le travail a été rapide, monsieur Robert a su s’adapter aux aléas du chantier et trouver des solutions.' },
  { note: 5, date: 'Septembre 2024', nom: 'Claude Cornet', texte: 'Entreprise artisanale et familiale depuis 3 générations. Le père, le fils et leurs 2 ouvriers m’ont fait un travail impeccable sur le bardage bois de mon chalet de 60 ans. Le résultat est surprenant : on dirait un chalet neuf ! Et le tout pour un prix tout à fait correct.' },
  { note: 5, date: 'Septembre 2023', nom: 'Florence Dubreuil', texte: 'Monsieur Robert est venu changer notre toiture et nos Velux à Montgeron. Le travail a été rapide et extrêmement bien fait. Son équipe a à cœur de finir le chantier dans les moindres détails. Le rapport qualité-prix est très bon. Nous recommandons vivement.' },
  { note: 5, date: 'Novembre 2023', nom: 'Michel', texte: 'Une intervention rapide et efficace. Un travail de qualité. Je suis très satisfait de votre intervention sur mon toit.' },
  { note: 5, date: 'Juin 2023', nom: 'Anne-Laure Thaurel', texte: 'Bravo pour votre professionnalisme et votre réactivité. Nous sommes très contents du résultat.' },
  { note: 5, date: 'Juillet 2022', nom: 'Denis Charles', texte: 'Éric est réactif, professionnel et de bons conseils. Nous avions un projet et ses conseils ont été précieux pour nous faire faire des économies. Nous recommandons vivement.' },
];

---
<Layout
  title="Couvreur 91 : Éric Couvreur, RGE Qualibat"
  description="Couvreur 91 : Éric Couvreur est à votre service pour réaliser tous vos travaux de couverture, d'isolation et de ravalement dans l'Essonne. Artisan RGE Qualibat."
  path="/"
>
  <section class="page-hero">
    <div class="container">
      <h1>Couvreur 91 : artisan couvreur RGE Qualibat dans l’Essonne</h1>
      <p class="page-hero__artisan">Éric Couvreur</p>
      <div class="page-hero__grid">
        <div class="page-hero__text">
          <p><strong>Entretien de toiture, réparation et rénovation de toiture</strong> : tous vos travaux de couverture, d’isolation et de ravalement, réalisés par un artisan certifié RGE Qualibat, à votre service depuis {company.foundingDate}.</p>
          <p>Devis et déplacement gratuits dans tout le département.</p>
          <div class="actions">
            <a class="btn btn--rouge btn--tel" href={company.mobileHref} aria-label={`Appeler le ${company.mobile}`} title={`Appeler le ${company.mobile}`}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="2" width="12" height="20" rx="2.5"/><path d="M12 18h.01"/></svg>{company.mobile}</a>
            <a class="btn btn--ghost" href="/devis-gratuit/" style="color:#fff;border-color:#fff">Demander un devis<span class="btn-menu__arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h11.5M12 6.5l5.5 5.5-5.5 5.5"/></svg></span></a>
          </div>
        </div>
        <div class="page-hero__media">
          <img src="/hero-eric-couvreur.webp" width="891" height="706" alt="Éric Couvreur et son équipe sur un chantier de rénovation de toiture dans l’Essonne" />
        </div>
      </div>
    </div>
  </section>

  <TrustBand showLogo />


  <section class="section promo-section">
    <div class="section-head section-head--txt-left">
      <h2>Un artisan certifié RGE pour améliorer la qualité de votre toiture</h2>
      <p><strong>Nos prestations éligibles aux aides (RGE Qualibat)</strong> : vos travaux d’isolation et de fenêtres de toit peuvent être financés par les aides de l’État.</p>
      <p><a href="https://annuaire-entreprises.data.gouv.fr/labels-certificats/821136488#rge" target="_blank" rel="noopener">Vérifier notre certification RGE sur l’annuaire officiel des entreprises</a></p>
    </div>
    <div class="promo-grid">
      {promos.map((p) => (
        <a class:list={['promo-card', p.accent && 'promo-card--accent', p.feature && 'promo-card--feature']} href={p.url}>
          <h3>{p.titre}</h3>
          <p>{p.desc}</p>
          {p.photo && <img class="promo-card__photo" src={p.photo} width="1063" height="709" alt={`${p.titre} posée par Éric Couvreur`} />}
          <span class="promo-card__brand">
            {p.brand === 'velux' && <img class="promo-velux" src="/logo-velux.webp" width="106" height="40" alt="Installateur Velux" />}
            {p.brand === 'icon' && !p.photo && <span class="promo-icon" set:html={svg(p.icon)} />}
            <span class="promo-card__more" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h11.5M12 6.5l5.5 5.5-5.5 5.5"/></svg></span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="split-feature">
    <div class="split-feature__inner">
      <div class="split-feature__left">
        <h2>Le spécialiste de la rénovation de toiture dans l’Essonne</h2>
        <p>Tuiles poreuses qui gèlent et se fendent, faîtage descellé, gouttières fatiguées : passé un certain âge, réparer une toiture coûte plus cher que la refaire. Éric Robert remplace les toitures anciennes de A à Z — dépose, reprise de charpente si besoin, écran de sous-toiture et couverture neuve posée pour cinquante ans. Confiez votre <a href="/prestations/renovation-detoiture/">rénovation de toiture</a> à un artisan couvreur certifié RGE.</p>
        <ul class="split-feature__list">
          <li class="is-active">Devis gratuit</li>
          <li>Intervention en moins de 48 heures</li>
          <li>Garantie décennale</li>
        </ul>
      </div>
      <div class="split-feature__right">
        <img class="split-feature__photo" src="/eric-robert-portrait.webp" width="450" height="337" alt="Éric Robert, artisan couvreur dans l'Essonne" />
        <div class="split-feature__card">
          <span class="split-feature__badge">Depuis {company.foundingDate}</span>
          <p>Des pavillons des années 60-70 de Savigny-sur-Orge, Sainte-Geneviève-des-Bois ou Massy aux maisons anciennes de l’Arpajonnais et du Hurepoix, Éric Robert, installé à Linas, rénove les toitures de tout le département — il connaît les toits de l’Essonne et leurs matériaux d’origine.</p>
          <p><strong>Tuiles mécaniques, tuiles plates, ardoises, zinc, bac acier ou shingle</strong> : tous les matériaux de couverture sont travaillés, dans le respect du style de votre maison — du toit à faible pente couvert en bac acier au brisis ardoisé d’une meulière.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-banner-section">
    <div class="cta-banner">
      <div class="cta-banner__media">
        <img src="/cta-estimation.webp" width="1920" height="845" alt="Artisans couvreurs Éric Couvreur dans l'Essonne" />
      </div>
      <div class="cta-banner__panel">
        <h2>Votre devis toiture gratuit dans le 91</h2>
        <p>Décrivez vos travaux, Éric Robert se déplace, constate et chiffre. Le devis est détaillé, sans engagement, et le déplacement gratuit dans tout l’Essonne — de Linas à Corbeil-Essonnes en passant par Palaiseau et Arpajon.</p>
        <a class="btn cta-banner__btn" href="/devis-gratuit/">Demander un devis gratuit</a>
      </div>
    </div>
  </section>

  <section class="section reviews">
    <div class="container">
      <div class="reviews__head">
        <h2>Ils nous ont fait confiance</h2>
        <div class="reviews__avg">
          <span class="stars" aria-hidden="true">★★★★☆</span>
          <strong>{company.reviews.rating}/5</strong> · {company.reviews.count} avis clients
        </div>
      </div>
      <div class="reviews__carousel">
        <button type="button" class="reviews__arrow" data-dir="-1" aria-label="Avis précédents">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg>
        </button>
        <div class="reviews__track" id="reviews-track">
          {reviews.map((r) => (
            <article class="review-card">
              <div class="stars" aria-label={`Note : ${r.note} sur 5`}>{'★'.repeat(r.note)}{'☆'.repeat(5 - r.note)}</div>
              <time class="review-card__date">{r.date}</time>
              <p class="review-card__text">{r.texte}</p>
              <div class="review-card__name">{r.nom}</div>
            </article>
          ))}
        </div>
        <button type="button" class="reviews__arrow" data-dir="1" aria-label="Avis suivants">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
        </button>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container media-split">
      <div class="media-split__text">
        <h2>Nettoyage et démoussage de toiture dans l’Essonne</h2>
        <p>La mousse retient l’humidité, ronge les tuiles et finit par ouvrir la porte aux infiltrations. Un <a href="/nettoyage-demoussage-toiture-91/">nettoyage et démoussage de toiture</a> régulier prolonge la vie de votre couverture et lui redonne son aspect d’origine.</p>
        <p>Après le nettoyage, un <a href="/traitement-anti-mousse-toiture-91/">traitement anti-mousse</a> empêche la végétation de revenir, et un <a href="/traitement-hydrofuge-toiture-91/">traitement hydrofuge</a> ré-imperméabilise les tuiles devenues poreuses. Trois gestes complémentaires, réalisés avec des produits professionnels Dalep.</p>
        <div class="media-split__partner">
          <span>Traitements professionnels</span>
          <img class="media-split__logo" src="/logo-dalep.webp" width="113" height="40" alt="Dalep — traitements pour le bâtiment" />
        </div>
      </div>
      <div class="media-split__media">
        <img src="/photo-nettoyage-toiture-1.webp" width="900" height="672" alt="Nettoyage et démoussage d'une toiture par Éric Couvreur dans l'Essonne" />
      </div>
    </div>
  </section>

  <section class="section media-section--dark">
    <div class="container media-split media-split--reverse">
      <div class="media-split__text">
        <h2>Gouttières, noues et chéneaux dans l’Essonne</h2>
        <p>Une gouttière qui déborde ou qui fuit, et c’est l’eau de pluie qui ruisselle sur la façade, s’infiltre dans les murs et attaque les fondations. La zinguerie n’est pas un détail : c’est elle qui évacue l’eau loin de votre maison.</p>
        <p>Pose et remplacement de gouttières en zinc ou en aluminium, façonnage des noues, chéneaux et abergements : ces ouvrages font partie de nos <a href="/travaux-de-couverture/">travaux de couverture</a>, réalisés dans les règles de l’art sur tout le département.</p>
        <a class="btn btn--rouge media-split__cta" href="/devis-gratuit/">Demander un devis<span class="btn-menu__arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h11.5M12 6.5l5.5 5.5-5.5 5.5"/></svg></span></a>
      </div>
      <div class="media-split__media">
        <img src="/photo-gouttieres-2.webp" width="400" height="400" alt="Pose de gouttières, noues et chéneaux par Éric Couvreur dans l'Essonne" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container media-split media-split--plain">
      <div class="media-split__text">
        <h2>Traitement de charpente dans l’Essonne</h2>
        <p>Capricornes, vrillettes, champignons : les bois de charpente vieillissent en silence, et l’on découvre souvent les dégâts trop tard. De la sciure au pied des poutres ou de petits trous dans le bois doivent vous alerter.</p>
        <p>Après diagnostic, le <a href="/traitement-de-charpente/">traitement de charpente</a> par injection ou pulvérisation stoppe les insectes xylophages et protège le bois pour des années. Un contrôle s’impose aussi avant tout projet d’<a href="/isolation-des-combles/">isolation des combles</a> : on n’isole jamais sur une charpente malade.</p>
        <a class="btn btn--rouge media-split__cta" href="/devis-gratuit/">Demander un devis<span class="btn-menu__arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h11.5M12 6.5l5.5 5.5-5.5 5.5"/></svg></span></a>
      </div>
      <div class="media-split__media">
        <img src="/photo-charpente.webp" width="1045" height="870" alt="Traitement de charpente réalisé par Éric Couvreur dans l'Essonne" />
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container">
      <h2>Confiez votre toiture à un artisan de confiance</h2>
      <p>Devis clair et gratuit, sans engagement. Éric Couvreur vous rappelle et se déplace chez vous dans tout l’Essonne.</p>
      <ul class="cta-band__trust">
        <li>Certifié RGE Qualibat</li>
        <li>Artisan local, basé à {company.city}</li>
        <li>À votre service depuis {company.foundingDate}</li>
        <li>Devis &amp; déplacement gratuits</li>
      </ul>
      <div class="cta-band__actions">
        <a class="btn btn--rouge btn--lg" href={company.mobileHref}>Appeler le {company.mobile}</a>
        <a class="btn btn--lg cta-band__ghost" href="/devis-gratuit/">Demander un devis<span class="btn-menu__arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h11.5M12 6.5l5.5 5.5-5.5 5.5"/></svg></span></a>
      </div>
    </div>
  </section>


  <script>
    (() => {
      const track = document.getElementById('reviews-track');
      if (!track) return;
      document.querySelectorAll('.reviews__arrow').forEach((btn) => {
        btn.addEventListener('click', () => {
          const dir = Number(btn.getAttribute('data-dir'));
          const first = track.querySelector('.review-card');
          const step = first ? first.getBoundingClientRect().width + 20 : track.clientWidth;
          track.scrollBy({ left: dir * step, behavior: 'smooth' });
        });
      });
    })();
  </script>
</Layout>
